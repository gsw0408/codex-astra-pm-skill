{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.astra-orchestrator/schemas/reviewer_result.schema.json",
  "title": "ReviewerResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "stage_id",
    "plan_revision_id",
    "ultimate_purpose",
    "verdict",
    "summary",
    "findings",
    "evidence_inspected",
    "missing_evidence",
    "known_limitations"
  ],
  "properties": {
    "review_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "stage_id": {"type": "string", "minLength": 1},
    "plan_revision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "ultimate_purpose": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PASS", "FAIL", "NEEDS_EVIDENCE"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_inspected": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "then": {
        "properties": {
          "evidence_inspected": {"minItems": 1},
          "missing_evidence": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "FAIL"}}},
      "then": {
        "properties": {
          "findings": {"minItems": 1},
          "evidence_inspected": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "NEEDS_EVIDENCE"}}},
      "then": {"properties": {"missing_evidence": {"minItems": 1}}}
    }
  ]
}
